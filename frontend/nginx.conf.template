server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Resolve the backend per request through Docker's DNS, so nginx starts even
    # while the backend service is down or being recreated.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend ${BACKEND_HOST}:${BACKEND_PORT};

    # The backend has no /api prefix.
    location /api/ {
        # Images attached to reviews are up to 10 MB (the backend's limit); nginx's default is 1 MB.
        client_max_body_size 12m;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Audio streams with HTTP Range: pass bytes through as they come.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # IPs banned for an SQL injection in the review field get banned.html instead of any page
    # (the backend's /ban/check answers 204 or 403 by the visitor's CF-Connecting-IP). If the
    # backend is down, pages are let through rather than taking the site down with it.
    location = /_ban_check {
        internal;
        proxy_pass http://$backend/ban/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_intercept_errors on;
        error_page 500 502 503 504 = @ban_check_unavailable;
    }

    location @ban_check_unavailable {
        return 204;
    }

    location @banned {
        rewrite ^ /banned.html break;
        add_header Cache-Control "no-store" always;
    }

    location = /banned.html {
        add_header Cache-Control "no-store";
    }

    # What banned.html itself needs, served without the ban check.
    location ^~ /ban/ {
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    location = /favicon.ico {
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    # nginx's mime.types has no .webmanifest.
    location = /site.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    location / {
        auth_request /_ban_check;
        error_page 403 @banned;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
