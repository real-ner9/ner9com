{
  "name": "ner9-backend",
  "version": "1.0.0",
  "description": "API for the NER9 site: music library streaming.",
  "main": "app.ts",
  "scripts": {
    "start": "npm run build:ts && fastify start -p 4101 -l info dist/app.js",
    "build:ts": "tsc",
    "watch:ts": "tsc -w",
    "dev": "npm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:dev:start\"",
    "dev:start": "fastify start -p 4101 --ignore-watch=.ts$ -w -l info -P dist/app.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@fastify/autoload": "^6.0.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.4",
    "@fastify/sensible": "^6.0.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.0.0",
    "fastify-cli": "^7.4.0",
    "fastify-plugin": "^5.0.0",
    "music-metadata": "^11.10.3",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.1.0",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.0.0",
    "fastify-tsconfig": "^3.0.0",
    "typescript": "~5.8.2"
  }
}
